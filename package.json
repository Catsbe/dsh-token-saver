{
  "name": "dsh-token-saver",
  "version": "0.3.0",
  "description": "Token-saving plugin for DeepSeek Harness: count-first grep/glob summaries, structure-aware JSON/JSONL/table/log compression with a never-worse gate, cross-turn dedupe, shadow mode, plus the original batch/step/re-read guidance. Append-only; never rewrites history or the tool set, so KV cache stays stable.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4 || >=4.0.6-alpha.2 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2 || >=3.18.6-alpha.2 <4.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "context",
    "token",
    "token-efficiency",
    "compression",
    "shadow",
    "cost",
    "steps"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catsbe/dsh-token-saver.git"
  },
  "homepage": "https://github.com/Catsbe/dsh-token-saver#readme",
  "bugs": {
    "url": "https://github.com/Catsbe/dsh-token-saver/issues"
  }
}
